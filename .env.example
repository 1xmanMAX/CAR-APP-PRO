# Base de datos: vacío = PGlite en DATA_DIR/pglite
DATABASE_URL=
DATA_DIR=./data
STORAGE_DIR=./storage

# simulado | beta (guías simuladas, facturas a beta SUNAT) | real
SUNAT_MODO=simulado
# beta | produccion. Vacío = produccion en modo real (nunca facturas silenciosamente a beta);
# en simulado/beta este valor no afecta al gateway. Déjalo vacío salvo que quieras forzar beta.
SUNAT_AMBIENTE_FACTURA=
# Forzar rechazo en modo simulado, formato codigo:mensaje
SUNAT_SIMULAR_RECHAZO=

# Solo para SUNAT_MODO=real
SUNAT_CERT_PATH=
SUNAT_CERT_PASSWORD=
SUNAT_SOL_USUARIO=
SUNAT_SOL_CLAVE=
SUNAT_GRE_CLIENT_ID=
SUNAT_GRE_CLIENT_SECRET=

# Datos iniciales (pnpm sembrar)
EMPRESA_RUC=
EMPRESA_RAZON_SOCIAL=
EMPRESA_DIRECCION=
EMPRESA_UBIGEO=
EMPRESA_REGISTRO_MTC=
EMPRESA_CUENTA_DETRACCION=
VEHICULO_PLACA=
# Carreta de la unidad habitual (opcional): sin ella el bot pregunta la placa secundaria
VEHICULO_PLACA_SECUNDARIA=
CONDUCTOR_DNI=
CONDUCTOR_NOMBRES=
CONDUCTOR_APELLIDOS=
CONDUCTOR_LICENCIA=
USUARIO_NOMBRE=
USUARIO_EMAIL=
USUARIO_TELEGRAM_ID=

# Bot de Telegram (apps/bot)
TELEGRAM_BOT_TOKEN=
# reglas | ia (lector del PDF de la guía del remitente)
EXTRACTOR=reglas
# Hora local HH:MM del aviso diario
BOT_HORA_AVISO=08:00
LOG_DIR=./logs

# Web (apps/web). pnpm app = bot + web en un solo proceso
WEB_HOST=0.0.0.0
WEB_PUERTO=3000
# Dirección con la que entras desde el celular o desde fuera (ej. http://192.168.1.10:3000 o https://flota.midominio.pe).
# La usa /web del bot para mandarte el enlace de entrada. Con https la cookie de sesión va marcada Secure.
WEB_URL_PUBLICA=
# Entrada directa (mientras la app está en desarrollo): desde el mismo equipo (la app de Android o
# http://localhost en la PC) entras como dueño sin formulario ni contraseña. Desde otro equipo se
# sigue pidiendo correo y contraseña. Pon 0 para volver a pedir la configuración inicial y el login.
ENTRADA_DIRECTA=1
